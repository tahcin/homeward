// Homeward: the built site (dist/) served from Cloudflare's asset store, with worker/index.ts in front of /api/*.
// Build first: `pnpm build`, then `pnpm wrangler deploy`.
// Secrets (never in this file): TOKENFACTORY_API_KEY and IP_SALT, set with `wrangler secret put`.
// Optional self-hosted grader (our fine-tuned Gemma 4 E4B behind an OpenAI-compatible server):
//   ONPREM_GRADER_URL (e.g. https://host/v1), ONPREM_GRADER_MODEL, ONPREM_GRADER_KEY (secret), ONPREM_GRADER_LABEL.
// Optional self-hosted speech recognition (OpenAI-compatible /audio/transcriptions): ONPREM_ASR_URL, ONPREM_ASR_MODEL.
{
  "name": "homeward",
  "compatibility_date": "2026-10-01",
  "account_id": "4627bf18a59329110c2a7a42c5562620",
  "main": "worker/index.ts",
  "assets": { "directory": "./dist", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*", "/assets/*"] },
  // Served on the owner's domain; workers.dev stays on as a fallback.
  "routes": [{ "pattern": "homeward.tahcin.tech", "custom_domain": true }],
  "workers_dev": true,
  "durable_objects": { "bindings": [{ "name": "GUARD", "class_name": "Guard" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Guard"] }],
  "vars": {
    // Set to "false" and redeploy to stop all live model calls at once (samples keep working).
    "LIVE_ENABLED": "true",
    "LIMIT_PER_IP_HOUR": "40",
    // Share of Token Factory's $1/day team cap this demo may spend.
    "LIMIT_USD_PER_DAY": "0.5",
    // Close live calls when the shared key has less than this left today.
    "MIN_UPSTREAM_USD": "0.05"
  },
  "observability": { "enabled": false }
}
